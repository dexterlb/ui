# i3 config file (v4)
#
# Please see http://i3wm.org/docs/userguide.html for a complete reference!
#
# This config file uses keycodes (bindsym) and was written for the QWERTY
# layout.
#
# To get a config file with the same key positions, but for your current
# layout, use the i3-config-wizard
#

{% set bind_flags = " --to-code" if i3_version == "sway" else "" %}
{% set mic_flags = " --to-code --no-repeat" if i3_version == "sway" else " --release" %}
{% set scroll_flags = " --no-repeat" if i3_version == "sway" else " --release" %}

# super key
{% if session_mode == "remote" %}
set $mod Mod1
{% else %}
set $mod Mod4
{% endif %}

set $hostname {{ hostname }}

# outputs
{% if hostname == "gallifrey" %}

workspace 1    output DP-1
workspace 2    output DP-1
workspace 3    output DP-1
workspace 4    output DP-1
workspace 5    output DP-1
workspace 6    output DP-1
workspace 7    output DP-1
workspace 8    output DP-1
workspace 9    output DP-1
workspace 10   output DP-1
workspace f1   output DP-2
workspace f2   output DP-2
workspace f3   output DP-2
workspace f4   output DP-2
workspace f5   output DP-2
workspace f6   output DP-2
workspace f7   output DP-2
workspace f8   output DP-2
workspace f9   output DP-2
workspace f10  output DP-2
workspace f11  output DP-2
workspace f12  output DP-2

{% if i3_version == "sway" %}
output DP-0 mode 1920x1200 pos 0 0
output DP-1 mode 1920x1200 pos 1920 0
{% endif %}

{% elif hostname == "kessel" %}

workspace 1    output eDP-1
workspace 2    output eDP-1
workspace 3    output eDP-1
workspace 4    output eDP-1
workspace 5    output eDP-1
workspace 6    output eDP-1
workspace 7    output eDP-1
workspace 8    output eDP-1
workspace 9    output eDP-1
workspace 10   output eDP-1
workspace f1   output HDMI-2
workspace f2   output HDMI-2
workspace f3   output HDMI-2
workspace f4   output HDMI-2
workspace f5   output HDMI-2
workspace f6   output HDMI-2
workspace f7   output HDMI-2
workspace f8   output HDMI-2
workspace f9   output HDMI-2
workspace f10  output HDMI-2
workspace f11  output HDMI-2
workspace f12  output HDMI-2

{% endif %}

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Aptos Mono 10

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# Before i3 v4.8, we used to recommend this one as the default:
# font -misc-fixed-medium-r-normal--13-120-75-75-C-70-iso10646-1
# The font above is very space-efficient, that is, it looks good, sharp and
# clear in small sizes. However, its unicode glyph coverage is limited, the old
# X core fonts rendering does not support right-to-left and this being a bitmap
# font, it doesn’t scale on retina/hidpi displays.

# Colours
# class                 border                  backgr.           text              indicator               child_border
client.focused          {{ col_highlight }}     {{ col_main }}    #ffffff           {{ col_highlight2 }}    {{ col_main }}
client.focused_inactive {{ col_inactive }}      {{ col_dull }}    #ffffff           {{ col_inactive2 }}     {{ col_dull }}
client.unfocused        {{ col_inactive }}      {{ col_dead }}    #888888           {{ col_dull2 }}         {{ col_dead }}
client.urgent           {{ col_urgent_bg }}     {{ col_urgent }}  #ffffff           {{ col_urgent }}        {{ col_urgent }}
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c

client.background       #ffffff

gaps inner 4
gaps outer 4

# use these keys for focus, movement, and resize directions when reaching for
# the arrows is not convenient
set $up k
set $down j
set $left h
set $right l

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym{{ bind_flags }} $mod+Return exec alacritty

# kill focused window
bindsym{{ bind_flags }} $mod+c kill

# start dmenu (a program launcher)
# bindsym $mod+p exec dmenu_run
# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
# bindsym $mod+d exec --no-startup-id i3-dmenu-desktop

# change focus
bindsym{{ bind_flags }} $mod+$left focus left
bindsym{{ bind_flags }} $mod+$down focus down
bindsym{{ bind_flags }} $mod+$up focus up
bindsym{{ bind_flags }} $mod+$right focus right

# alternatively, you can use the cursor keys:
bindsym{{ bind_flags }} $mod+Left focus left
bindsym{{ bind_flags }} $mod+Down focus down
bindsym{{ bind_flags }} $mod+Up focus up
bindsym{{ bind_flags }} $mod+Right focus right

# move focused window
bindsym{{ bind_flags }} $mod+Shift+$left move left
bindsym{{ bind_flags }} $mod+Shift+$down move down
bindsym{{ bind_flags }} $mod+Shift+$up move up
bindsym{{ bind_flags }} $mod+Shift+$right move right

# alternatively, you can use the cursor keys:
bindsym{{ bind_flags }} $mod+Shift+Left move left
bindsym{{ bind_flags }} $mod+Shift+Down move down
bindsym{{ bind_flags }} $mod+Shift+Up move up
bindsym{{ bind_flags }} $mod+Shift+Right move right

# split in horizontal orientation
bindsym{{ bind_flags }} $mod+s split h

# split in vertical orientation
bindsym{{ bind_flags }} $mod+v split v

# enter fullscreen mode for the focused container
bindsym{{ bind_flags }} $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym{{ bind_flags }} $mod+r layout stacking
bindsym{{ bind_flags }} $mod+w layout tabbed
bindsym{{ bind_flags }} $mod+e layout toggle split
bindsym{{ bind_flags }} $mod+space layout toggle split

# toggle tiling / floating
bindsym{{ bind_flags }} $mod+t floating toggle

# change focus between tiling / floating windows
bindsym{{ bind_flags }} $mod+shift+Tab focus mode_toggle

# focus the parent container
bindsym{{ bind_flags }} $mod+a focus parent

# focus the child container
bindsym{{ bind_flags }} $mod+d focus child

# move the currently focused window to the scratchpad
bindsym{{ bind_flags }} $mod+Shift+s move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym{{ bind_flags }} $mod+minus scratchpad show

# switch to workspace
bindsym{{ bind_flags }} $mod+1 workspace 1
bindsym{{ bind_flags }} $mod+2 workspace 2
bindsym{{ bind_flags }} $mod+3 workspace 3
bindsym{{ bind_flags }} $mod+4 workspace 4
bindsym{{ bind_flags }} $mod+5 workspace 5
bindsym{{ bind_flags }} $mod+6 workspace 6
bindsym{{ bind_flags }} $mod+7 workspace 7
bindsym{{ bind_flags }} $mod+8 workspace 8
bindsym{{ bind_flags }} $mod+9 workspace 9
bindsym{{ bind_flags }} $mod+0 workspace 10
bindsym{{ bind_flags }} $mod+F1 workspace f1
bindsym{{ bind_flags }} $mod+F2 workspace f2
bindsym{{ bind_flags }} $mod+F3 workspace f3
bindsym{{ bind_flags }} $mod+F4 workspace f4
bindsym{{ bind_flags }} $mod+F5 workspace f5
bindsym{{ bind_flags }} $mod+F6 workspace f6
bindsym{{ bind_flags }} $mod+F7 workspace f7
bindsym{{ bind_flags }} $mod+F8 workspace f8
bindsym{{ bind_flags }} $mod+F9 workspace f9
bindsym{{ bind_flags }} $mod+F10 workspace f10
bindsym{{ bind_flags }} $mod+F11 workspace f11
bindsym{{ bind_flags }} $mod+F12 workspace f12

bindsym{{ bind_flags }} $mod+Mod1+1 nop do switch_current_display_workspace 1
bindsym{{ bind_flags }} $mod+Mod1+2 nop do switch_current_display_workspace 2
bindsym{{ bind_flags }} $mod+Mod1+3 nop do switch_current_display_workspace 3
bindsym{{ bind_flags }} $mod+Mod1+4 nop do switch_current_display_workspace 4
bindsym{{ bind_flags }} $mod+Mod1+5 nop do switch_current_display_workspace 5
bindsym{{ bind_flags }} $mod+Mod1+6 nop do switch_current_display_workspace 6
bindsym{{ bind_flags }} $mod+Mod1+7 nop do switch_current_display_workspace 7
bindsym{{ bind_flags }} $mod+Mod1+8 nop do switch_current_display_workspace 8
bindsym{{ bind_flags }} $mod+Mod1+9 nop do switch_current_display_workspace 9
bindsym{{ bind_flags }} $mod+Mod1+0 nop do switch_current_display_workspace 10
bindsym{{ bind_flags }} $mod+Mod1+F1 nop do switch_current_display_workspace f1
bindsym{{ bind_flags }} $mod+Mod1+F2 nop do switch_current_display_workspace f2
bindsym{{ bind_flags }} $mod+Mod1+F3 nop do switch_current_display_workspace f3
bindsym{{ bind_flags }} $mod+Mod1+F4 nop do switch_current_display_workspace f4
bindsym{{ bind_flags }} $mod+Mod1+F5 nop do switch_current_display_workspace f5
bindsym{{ bind_flags }} $mod+Mod1+F6 nop do switch_current_display_workspace f6
bindsym{{ bind_flags }} $mod+Mod1+F7 nop do switch_current_display_workspace f7
bindsym{{ bind_flags }} $mod+Mod1+F8 nop do switch_current_display_workspace f8
bindsym{{ bind_flags }} $mod+Mod1+F9 nop do switch_current_display_workspace f9
bindsym{{ bind_flags }} $mod+Mod1+F10 nop do switch_current_display_workspace f10
bindsym{{ bind_flags }} $mod+Mod1+F11 nop do switch_current_display_workspace f11
bindsym{{ bind_flags }} $mod+Mod1+F12 nop do switch_current_display_workspace f12

# move focused container to workspace
bindsym{{ bind_flags }} $mod+Shift+1 move container to workspace 1
bindsym{{ bind_flags }} $mod+Shift+2 move container to workspace 2
bindsym{{ bind_flags }} $mod+Shift+3 move container to workspace 3
bindsym{{ bind_flags }} $mod+Shift+4 move container to workspace 4
bindsym{{ bind_flags }} $mod+Shift+5 move container to workspace 5
bindsym{{ bind_flags }} $mod+Shift+6 move container to workspace 6
bindsym{{ bind_flags }} $mod+Shift+7 move container to workspace 7
bindsym{{ bind_flags }} $mod+Shift+8 move container to workspace 8
bindsym{{ bind_flags }} $mod+Shift+9 move container to workspace 9
bindsym{{ bind_flags }} $mod+Shift+0 move container to workspace 10
bindsym{{ bind_flags }} $mod+Shift+F1 move container to workspace f1
bindsym{{ bind_flags }} $mod+Shift+F2 move container to workspace f2
bindsym{{ bind_flags }} $mod+Shift+F3 move container to workspace f3
bindsym{{ bind_flags }} $mod+Shift+F4 move container to workspace f4
bindsym{{ bind_flags }} $mod+Shift+F5 move container to workspace f5
bindsym{{ bind_flags }} $mod+Shift+F6 move container to workspace f6
bindsym{{ bind_flags }} $mod+Shift+F7 move container to workspace f7
bindsym{{ bind_flags }} $mod+Shift+F8 move container to workspace f8
bindsym{{ bind_flags }} $mod+Shift+F9 move container to workspace f9
bindsym{{ bind_flags }} $mod+Shift+F10 move container to workspace f10
bindsym{{ bind_flags }} $mod+Shift+F11 move container to workspace f11
bindsym{{ bind_flags }} $mod+Shift+F12 move container to workspace f12

bindsym{{ bind_flags }} $mod+Mod1+Left move workspace to output left
bindsym{{ bind_flags }} $mod+Mod1+Right move workspace to output right

bindsym{{ bind_flags }} $mod+Mod1+h move workspace to output left
bindsym{{ bind_flags }} $mod+Mod1+l move workspace to output right

# reload the configuration file
# bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym{{ bind_flags }} $mod+q restart
# exit i3 (logs you out of your X session)
bindsym{{ bind_flags }} $mod+Shift+q exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym{{ bind_flags }} $left       resize shrink width 10 px or 10 ppt
        bindsym{{ bind_flags }} $down       resize grow height 10 px or 10 ppt
        bindsym{{ bind_flags }} $up         resize shrink height 10 px or 10 ppt
        bindsym{{ bind_flags }} $right      resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym{{ bind_flags }} Left        resize shrink width 10 px or 10 ppt
        bindsym{{ bind_flags }} Down        resize grow height 10 px or 10 ppt
        bindsym{{ bind_flags }} Up          resize shrink height 10 px or 10 ppt
        bindsym{{ bind_flags }} Right       resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape
        bindsym{{ bind_flags }} Return mode "default"
        bindsym{{ bind_flags }} Escape mode "default"
}

bindsym{{ bind_flags }} $mod+Shift+r mode "resize"

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)

{% if i3_version == "i3" %}
    {% set col_bar_bg = col_bar_bg_solid %}
{% endif %}

bar {
      font pango:Aptos Mono, Font Awesome 13
      position top
      height 20
{% if i3_version == "i3_gaps" %}
      i3bar_command i3bar -t
{% endif %}
      status_command i3status-rs {{ ui_dir }}/i3/status.toml
      colors {
            separator #666666
            background {{ col_bar_bg }}
            statusline #dddddd
            focused_workspace {{ col_bar_bg }} {{ col_bar_bg }} {{ col_highlight_text }}
            active_workspace {{ col_bar_bg }} {{ col_bar_bg }} {{ col_highlight_text2 }}
            inactive_workspace {{ col_bar_bg }} {{ col_bar_bg }} {{ col_inactive_text }}
            urgent_workspace {{ col_urgent }} {{ col_urgent }} {{ col_urgent_text }}
      }
}

bindsym{{ bind_flags }} $mod+Control+p nop send music_pause
bindsym{{ bind_flags }} Pause nop send music_pause
bindsym{{ bind_flags }} $mod+Control+Escape nop send music_stop
bindsym{{ bind_flags }} $mod+Control+Right nop send music_next
bindsym{{ bind_flags }} $mod+Control+Left nop send music_previous
bindsym{{ bind_flags }} $mod+Control+Up nop send music_volume +1
bindsym{{ bind_flags }} $mod+Control+Down nop send music_volume -1
bindsym --release --whole-window $mod+Control+button5 nop send music_volume -1
bindsym --release --whole-window $mod+Control+button4 nop send music_volume +1
bindsym{{ bind_flags }} $mod+Control+period nop send music_home

bindsym{{ bind_flags }} $mod+Mod1+r exec {{ ui_dir }}/redshift_control.sh start
bindsym{{ bind_flags }} $mod+Mod1+b exec {{ ui_dir }}/redshift_control.sh stop

bindsym{{ bind_flags }} $mod+Mod1+minus   exec xbacklight -dec 4
bindsym{{ bind_flags }} $mod+Mod1+plus    exec xbacklight -inc 4
bindsym{{ bind_flags }} $mod+Shift+minus  exec xbacklight -dec 1
bindsym{{ bind_flags }} $mod+Shift+plus   exec xbacklight -inc 1

bindsym{{ bind_flags }} $mod+Mod1+n nop send notification_next

bindsym{{ bind_flags }} $mod+Escape exec {{ ui_dir }}/session_menu.sh

bindsym{{ bind_flags }} $mod+Control+d exec {{ ui_dir }}/theme_variant.sh dark
bindsym{{ bind_flags }} $mod+Control+l exec {{ ui_dir }}/theme_variant.sh light

bindsym{{ bind_flags }} --release Print exec {{ screenshooter }} full
bindsym{{ bind_flags }} --release Shift+Print exec {{ screenshooter }} region
bindsym{{ bind_flags }} --release Control+Print exec {{ screenshooter }} window
bindsym{{ bind_flags }} --release $mod+Control+y exec {{ screenshooter }} window
bindsym{{ bind_flags }} --release $mod+y exec {{ screenshooter }} full
bindsym{{ bind_flags }} --release $mod+Shift+y exec {{ screenshooter }} region
bindsym{{ bind_flags }} --release $mod+p exec {{ ui_dir }}/runmenu.sh run
bindsym{{ bind_flags }} --release $mod+Tab exec {{ ui_dir }}/runmenu.sh window
bindsym{{ bind_flags }} $mod+Print exec {{ screenshooter }}

bindsym{{ bind_flags }} --release $mod+Mod1+d exec {{ ui_dir }}/detect_displays.sh
bindsym{{ bind_flags }} --release $mod+Mod1+c exec {{ ui_dir }}/detect_displays.sh clone
bindsym{{ bind_flags }} --release $mod+Mod1+s exec {{ ui_dir }}/detect_displays.sh single

# bind scroll lock key to mute/unmute mic when not used in combination
bindcode{{ scroll_flags }} 78 exec "{{ ui_dir }}/mic_mute.sh restrictive_toggle; pkill -SIGRTMIN+4 i3status"
bindsym{{ mic_flags }} $mod+m exec "{{ ui_dir }}/mic_mute.sh restrictive_toggle; pkill -SIGRTMIN+4 i3status"

# per-window configuration

# assign [class="^Steam$"] 6
# assign [class="^dota2$"] 6
# assign [class="^explorer\.exe$"] 6
# assign [class="^Firefox$"] 2
# assign [class="^Hexchat$"] 3
# assign [class="^Mumble$"] 3
# assign [class="^telegram-desktop$"] 3


{% if i3_version == "sway" %}
    input 9610:30:HAILUCK_CO.,LTD_USB_KEYBOARD_Touchpad {
        tap enabled
    }
    output "*" background {{ wallpaper }} fill
    include /etc/sway/config.d/*
    exec {{ ui_dir }}/startup_wayland.sh
{% else %}
    exec {{ ui_dir }}/startup.sh
{% endif %}
